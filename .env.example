# Telemetry HTTP Server Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin
# cp .env.example .env

# ==================== SUNUCU ====================
PORT=3000
NODE_ENV=development

# ==================== VERİTABANI ====================
MONGODB_URI=mongodb://127.0.0.1:27017/telemetry

# ==================== JWT KİMLİK DOĞRULAMA ====================
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ==================== ADMIN KULLANICISI (ilk kurulum) ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-replace-this

# ==================== SEED KULLANICILARI (sadece development) ====================
# POST /api/auth/seed endpoint'i bu değerleri kullanır.
# Production'da bu endpoint otomatik engellenir (NODE_ENV=production).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme-replace-this
SEED_MEMBER_USERNAME=member
SEED_MEMBER_PASSWORD=changeme-replace-this
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=changeme-replace-this

# ==================== CİHAZ API KEY ====================
# STM32/ESP8266 cihazlarına verilen key (?key=XXXX query parametresi)
# Tanımlanmazsa /ingest endpoint'i key kontrolü yapmaz (development).
DEVICE_API_KEY=your-device-api-key-here

# ==================== CORS ====================
# Virgülle ayrılmış izin verilen origin'ler
CORS_ORIGINS=http://localhost:3000
SOCKET_ORIGIN=*

# ==================== REDİS (opsiyonel) ====================
# Tanımlanmazsa cache devre dışı kalır, sistem çalışmaya devam eder.
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ==================== GOOGLE DRIVE GALERİSİ (opsiyonel) ====================
# Google Apps Script Web App URL'si — Drive klasöründeki fotoğrafları listeler.
# Apps Script'te Web App olarak yayınla → URL'yi buraya yapıştır.
# Tanımlanmazsa galeri "Yapılandırılmadı" uyarısı gösterir.
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
